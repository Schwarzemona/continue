{
  "name": "@continuedev/cli",
  "version": "2.0.0",
  "description": "Continue CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "cn": "dist/cn.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:smoke": "node smoke-test.mjs",
    "test:smoke-api": "vitest run --config vitest.smoke-api.config.ts",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:local-deps": "cd ../../packages/config-types && npm i && npm run build && cd ../fetch && npm i && npm run build && cd ../llm-info && npm i && npm run build && cd ../terminal-security && npm i && npm run build && cd ../config-yaml && npm i && npm run build && cd ../openai-adapters && npm i && npm run build && cd ../continue-sdk && npm --prefix typescript i --ignore-scripts && npm --prefix typescript run build:portable && cd ../../core && npm i && npm run build && cd ../extensions/cli && npm i --ignore-scripts && npm run build",
    "build:validate": "node validate-aliases.mjs",
    "build:bundle": "node build.mjs",
    "build": "npm run build:validate && npm run build:bundle",
    "start": "node dist/cn.js",
    "dev": "tsx src/index.ts",
    "repomix:sdk": "npx repomix node_modules/@continuedev/sdk --ignore **/api,cli-repomix.xml -o sdk-repomix.xml",
    "repomix:cli": "npx repomix --ignore sdk-repomix.xml -o cli-repomix.xml",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "watch:logs": "touch ~/.continue/logs/cn.log && tail -f ~/.continue/logs/cn.log",
    "prepare": "npm run build",
    "semantic-release": "semantic-release",
    "semantic-release:dry-run": "semantic-release --dry-run"
  },
  "author": "Schwarzemona (forked from Continue Dev, Inc)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Schwarzemona/continue.git"
  },
  "bugs": {
    "url": "https://github.com/Schwarzemona/continue/issues"
  },
  "homepage": "https://continue.dev",
  "dependencies": {
    "fdir": "^6.5.0",
    "find-up": "^8.0.0",
    "fzf": "^0.5.2",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@continuedev/config-yaml": "file:../../packages/config-yaml",
    "@continuedev/openai-adapters": "file:../../packages/openai-adapters",
    "@continuedev/sdk": "file:../../packages/continue-sdk/typescript",
    "@continuedev/terminal-security": "file:../../packages/terminal-security",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/date-fns": "^2.6.3",
    "@types/diff": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/glob": "^9.0.0",
    "@types/ignore-walk": "^4.0.3",
    "@types/ink-testing-library": "^1.0.4",
    "@types/jszip": "^3.4.1",
    "@types/nock": "^11.1.0",
    "@types/react": "^19.3.3",
    "@types/shell-quote": "^1.7.5",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/ui": "^5.1.2",
    "@workos-inc/node": "^12.4.0",
    "chalk": "^6.0.1",
    "clipboardy": "^5.3.2",
    "commander": "^15.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "core": "file:../../core",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^10.2.1",
    "express": "^5.3.0",
    "glob": "^14.0.6",
    "gpt-tokenizer": "^4.1.2",
    "gradient-string": "^3.0.0",
    "happy-dom": "^21.0.4",
    "ignore": "^7.0.17",
    "ignore-walk": "^9.0.1",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^31.0.1",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0",
    "minimatch": "^11.0.9",
    "nock": "^15.0.6",
    "node-fetch": "^3.3.2",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "openai": "^4.104.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "semantic-release": "^26.0.1",
    "shell-quote": "^1.12.0",
    "supertest": "^7.3.2",
    "swr": "^2.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "typescript": "^6.0.3",
    "uuid": "^14.0.3",
    "vitest": "^5.1.2",
    "winston": "^3.19.0",
    "yaml": "^2.9.1"
  },
  "engine": {
    "node": ">=26.13.1"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.35.5",
    "@img/sharp-darwin-x64": "^0.35.5",
    "@img/sharp-linux-arm": "^0.35.5",
    "@img/sharp-linux-arm64": "^0.35.5",
    "@img/sharp-linux-x64": "^0.35.5",
    "@img/sharp-win32-x64": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true,
    "@parcel/watcher": true,
    "onnxruntime-node": true,
    "puppeteer-chromium-resolver": true,
    "puppeteer": true,
    "sqlite3": true,
    "win-ca": true,
    "win-export-certificate-and-key": true
  }
}
