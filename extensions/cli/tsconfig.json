{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmitOnError": false,
    "types": ["node", "vitest/globals"],
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "jsx": "react",
    "paths": {
      "core/*": ["../../core/dist/*"],
      "core": ["../../core/dist/index.js"],
      "src/*": ["./src/*"],
      "node_modules/@continuedev/*": ["./node_modules/@continuedev/*"]
    }
  },
  "include": ["src/**/*", "vitest.setup.ts", "vitest.global-dir-setup.ts"]
}
